{
  "name": "casimirq",
  "version": "1.0.0",
  "description": "A modular quantum circuit simulation platform - Phase 1",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint '{src,apps,libs,test}/**/*.ts' --fix",
    "lint:ci": "eslint '{src,apps,libs,test}/**/*.ts' --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "openapi:generate": "nest build && node dist/scripts/generate-openapi.js",
    "migrate": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "migrate:create": "node-pg-migrate create",
    "test": "jest",
    "test:ci": "jest --ci",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "verify:math": "jest --testPathPatterns='complex|matrix' --verbose",
    "verify:gates": "jest --testPathPatterns='gate' --verbose",
    "verify:circuits": "jest --testPathPatterns='circuit' --verbose",
    "verify:statevector": "jest --testPathPatterns='statevector|simulation' --verbose --testTimeout=30000"
  },
  "keywords": [
    "quantum",
    "simulator",
    "qasm",
    "quantum-computing",
    "nestjs"
  ],
  "author": "casimirQ Team",
  "license": "MIT",
  "dependencies": {
    "@nestjs/common": "^11.1.27",
    "@nestjs/core": "^11.1.27",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.27",
    "@nestjs/platform-socket.io": "^11.1.27",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/websockets": "^11.1.27",
    "@types/express": "^5.0.6",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "node-pg-migrate": "^7.9.1",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.23",
    "@nestjs/testing": "^11.1.27",
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.0.1",
    "@types/pg": "^8.20.0",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.4.2",
    "prettier": "^3.8.5",
    "ts-jest": "^29.4.11",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
